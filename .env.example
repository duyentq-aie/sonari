# Local development settings. `make infra` copies this to .env when .env is missing.
# These passwords are for a database bound to 127.0.0.1 only. Never reuse them anywhere else.
# Do not quote values or add inline comments: compose and the tests both read this file.
# Do not `source` it in a shell either: the URIs contain `&`, which a shell runs in the
# background.

# MongoDB root account, used only by the container itself (init script and healthcheck).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root-dev-only

# One user per service, each limited to the databases of its own contexts (ADR-0001).
MONGO_CORE_PASSWORD=core-dev-only
MONGO_SPEECH_PASSWORD=speech-dev-only

# Connection strings. directConnection=true because the single replica-set member
# advertises "localhost:27017", which clients outside the container reach on that port
# only by connecting to it directly (no topology discovery).
MONGO_URI_CORE=mongodb://core:core-dev-only@localhost:27017/?authSource=admin&directConnection=true
MONGO_URI_SPEECH=mongodb://speech:speech-dev-only@localhost:27017/?authSource=admin&directConnection=true

REDIS_URL=redis://localhost:6379/0

# Optional telemetry for services/core. Spans are always created, so logs carry trace ids;
# they leave the process only when an OTLP/HTTP endpoint is set. OTEL_ENABLED=false turns
# it off (the unit tests do).
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Authentication (services/core). JWT_SECRET signs access tokens and must be at least 32
# characters; generate one with `openssl rand -base64 48`. The Turnstile key below is
# Cloudflare's documented test secret that always passes; use a real one outside dev.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Offline content generation only (tools/glosses; never at learner runtime, ADR-0004). Any chat
# completions API: the base URL up to /v1, the model, and its USD prices per million tokens.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_PRICE_IN=
# LLM_PRICE_OUT=
# Optional: LLM traces to Langfuse over OTLP. Without both keys nothing is exported.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
